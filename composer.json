{
  "name": "spinen/laravel-quickbooks-client",
  "description": "SPINEN's Laravel Client for QuickBooks.",
  "keywords": [
    "quickbooks",
    "client",
    "laravel",
    "spinen"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Jimmy Puckett",
      "email": "jimmy.puckett@spinen.com"
    },
    {
      "name": "Anthony Rickard",
      "email": "arickard@lucidadvertising.com"
    },
  ],
  "require": {
    "php": "^8.2",
    "nesbot/carbon": "^3.9",
    "quickbooks/v3-php-sdk": "^6.2"
  },
  "require-dev": {
    "laravel/pint": "^1.13",
    "mockery/mockery": "^1.6",
  },
  "autoload": {
    "psr-4": {
      "Spinen\\QuickBooks\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Spinen\\QuickBooks\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Spinen\\QuickBooks\\Providers\\ServiceProvider",
        "Spinen\\QuickBooks\\Providers\\ClientServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
